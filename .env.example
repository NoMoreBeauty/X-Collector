# ===========================================
# X Information Collector 环境变量配置
# ===========================================
# 复制此文件为 .env 并填写实际值

# ----- AI API Keys -----
# 目前使用的供应商 (在 config.yaml 中设置 ai.provider)
DASHSCOPE_API_KEY=your_dashscope_api_key_here

# 备用供应商 (可选，留空即可)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GOOGLE_API_KEY=

# ----- 邮件通知配置 -----
# SMTP 服务器配置
# QQ邮箱: smtp.qq.com:587
# 163邮箱: smtp.163.com:465
# Gmail: smtp.gmail.com:587
EMAIL_SMTP_HOST=smtp.qq.com
EMAIL_SMTP_PORT=587
EMAIL_USE_TLS=true

# 发件人邮箱
EMAIL_FROM=your_email@qq.com

# 登录账号 (通常是邮箱地址)
EMAIL_USERNAME=your_email@qq.com

# 客户端专用密码 (不是邮箱登录密码!)
# QQ邮箱: 设置 → 账户 → POP3/SMTP → 生成授权码
# Gmail: Google账户 → 安全 → 应用专用密码
# 163邮箱: 设置 → POP3/SMTP → 授权码
EMAIL_PASSWORD=your_app_specific_password_here
